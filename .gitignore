# 本地接口响应、编辑器配置与辅助工具工作目录。
/接口json/
.vscode/
/.workbuddy/
/.playwright-cli/
.idea/

# 按当前项目约定，后端测试（含 fixtures）与文档只在本地保留。
/backend/tests/
/docs/

# Python 虚拟环境、字节码与工具缓存。
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 前端依赖、构建产物与检查缓存。
node_modules/
dist/
dist-ssr/
.vite/
.eslintcache
*.tsbuildinfo

# 测试覆盖率与浏览器测试生成的报告。
coverage/
htmlcov/
.coverage
.coverage.*
playwright-report/
test-results/

# 本地排查响应、截图、页面原型与运行日志。
/output/
logs/
*.log

# 本机环境变量配置；可提交用于说明配置项的示例模板。
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 操作系统自动生成的文件。
.DS_Store
Thumbs.db
Desktop.ini
